# ==============================================================================
# MEHTA DAIRY - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHIPROCKET AUTOMATED SHIPPING INTEGRATION
# ------------------------------------------------------------------------------
# Your registered Shiprocket account email address
SHIPROCKET_EMAIL="your_shiprocket_email@example.com"

# Your registered Shiprocket account password
# IMPORTANT: Keep this secret! Never add NEXT_PUBLIC_ prefix to passwords!
SHIPROCKET_PASSWORD="your_shiprocket_password"

# Pickup location nickname registered in your Shiprocket panel (e.g. Primary, Warehouse1, Store)
SHIPROCKET_PICKUP_LOCATION="Primary"

# Secret token used to authenticate incoming webhooks at /api/webhooks/shiprocket
# Configure this exact secret in your Shiprocket Webhook Settings (Header: x-shiprocket-secret)
SHIPROCKET_WEBHOOK_SECRET="shiprocket_wh_secret_mehta_2026"


# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"


# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"


# ------------------------------------------------------------------------------
# 4. WHATSAPP NOTIFICATION SERVICE (AiSensy / WhatsApp Business)
# ------------------------------------------------------------------------------
AISENSY_API_KEY="your_aisensy_api_key"
AISENSY_APP_NAME="Mehta Sweet Mart"


# ------------------------------------------------------------------------------
# 5. RESEND EMAIL SERVICE
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
SENDER_EMAIL="orders@mehtadairy.com"


# ------------------------------------------------------------------------------
# 6. APP PLATFORM CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://mehtadairy.com"
JWT_SECRET="your-jwt-production-secret-key-min-32-chars"
CRON_SECRET="your-cron-security-secret-key"
